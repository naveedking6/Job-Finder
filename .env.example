# ---------------------------------------------------------------------
# AI Job Finder / AI Sales Agent — Environment Variables
#
# Copy this file to .env for local development (never commit .env).
# In production, set these in the hosting platform's dashboard (Render
# for the API, Vercel for the dashboard) or as GitHub Actions Secrets
# for scheduled workflows — never in the repository.
#
# Full description of every variable: docs/ENVIRONMENT.md
# ---------------------------------------------------------------------

# --- Database (Supabase Postgres connection string) ---
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# --- API server ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# --- Auth ---
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- AI Providers (Round 2+, pay-per-use — see docs/ADR.md section 7) ---
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
DEFAULT_AI_PROVIDER="anthropic"

# --- WhatsApp handoff (Round 2+) ---
WHATSAPP_BUSINESS_NUMBER="+10000000000"

# --- Automation control ---
AUTOMATION_ENABLED=false

# --- CI / scheduled trigger auth (Round 2+) ---
# Shared secret the GitHub Actions cron workflow sends so the API can
# verify scheduled trigger requests aren't coming from the public internet.
SCHEDULER_SHARED_SECRET="replace-with-a-long-random-string"
